{
  "version": "1.0",
  "description": "Standardized action vocabulary for all question if_yes_action and if_no_action fields. Four enum types are permitted.",
  "enum_types": {
    "CONTINUE": {
      "description": "Move to the next question in sequence. No pathway change. No alert raised.",
      "example": "CONTINUE"
    },
    "RED_FLAG": {
      "description": "Raise a clinical red flag for the specified rf_code. Triggers immediate alert in the UI. Format: RED_FLAG(rf_code)",
      "example": "RED_FLAG(RF_TESTICULAR_TORSION)"
    },
    "ESCALATE": {
      "description": "Emergency or urgent escalation — stop questioning and route immediately to emergency or urgent care pathway.",
      "example": "ESCALATE"
    },
    "GOTO_PATHWAY": {
      "description": "Branch to a named clinical pathway. Questioning continues from the entry point of that pathway. Format: GOTO_PATHWAY(pathway_id)",
      "example": "GOTO_PATHWAY(ISCHEMIC)"
    }
  },
