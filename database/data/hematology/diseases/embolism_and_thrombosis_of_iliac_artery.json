    "differentials":  [
                          {
                              "disease_code":  "EMBOLISM_AND_THROMBOSIS_OF_OTHER_ARTERIES",
                              "distinguishing_feature":  "[LLM DRAFT] Presents with acute ischemia affecting a different arterial bed, such as the upper extremities or visceral vessels, rather than the lower limb and pelvic ischemia typical of iliac occlusion."
                          },
                          {
                              "disease_code":  "EMBOLISM_AND_THROMBOSIS_OF_THORACIC_AORTA",
                              "distinguishing_feature":  "[LLM DRAFT] Presents with signs of proximal major trunk obstruction, such as acute upper and lower extremity perfusion deficits or back pain, rather than isolated unilateral lower extremity ischemia."
                          },
                          {
                              "disease_code":  "EMBOLISM_AND_THROMBOSIS_OF_UNSPECIFIED_ARTERY",
                              "distinguishing_feature":  "[LLM DRAFT] Represents an unlocalized vascular occlusion lacking the specific anatomic localization to the iliac bifurcation that characterizes lower limb claudication, rest pain, or pulselessness."
                          }
