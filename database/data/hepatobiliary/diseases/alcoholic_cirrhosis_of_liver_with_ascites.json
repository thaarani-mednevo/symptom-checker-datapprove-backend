    "differentials":  [
                          {
                              "disease_code":  "ALCOHOLIC_HEPATITIS_WITH_ASCITES",
                              "distinguishing_feature":  "Alcoholic hepatitis is an acute febrile inflammatory episode; cirrhosis with ascites is a chronic fibrotic state. The two may coexist and can be distinguished by LFT pattern, biopsy, and clinical course."
                          },
                          {
                              "disease_code":  "MALIGNANT_ASCITES",
                              "distinguishing_feature":  "Malignant ascites shows SAAG \u003c1.1 g/dL with high protein; portal hypertension ascites shows SAAG \u003e1.1 g/dL. Cytology may show malignant cells in malignant ascites."
                          },
                          {
                              "disease_code":  "HEPATOCELLULAR_CARCINOMA",
                              "distinguishing_feature":  "HCC is a complication of cirrhosis; acute deterioration with raised AFP, new hepatic lesion on imaging, or vascular invasion should prompt urgent HCC investigation."
                          }
