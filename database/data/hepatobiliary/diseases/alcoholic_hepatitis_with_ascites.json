    "differentials":  [
                          {
                              "disease_code":  "ALCOHOLIC_CIRRHOSIS_OF_LIVER_WITH_ASCITES",
                              "distinguishing_feature":  "Cirrhosis is a chronic fibrotic end-stage disease with stable portal hypertension; alcoholic hepatitis with ascites is an acute inflammatory episode which may be superimposed on cirrhosis and presents with more rapid deterioration and fever."
                          },
                          {
                              "disease_code":  "SPONTANEOUS_BACTERIAL_PERITONITIS",
                              "distinguishing_feature":  "SBP is a complication of ascites presenting with fever, abdominal pain, and altered mental status; it is diagnosed by ascitic fluid PMN count \u003e250 cells/mm3 on diagnostic paracentesis."
                          },
                          {
                              "disease_code":  "MALIGNANT_ASCITES",
                              "distinguishing_feature":  "Malignant ascites is due to peritoneal carcinomatosis or hepatic metastases and shows exudative fluid with high protein; alcoholic hepatitis ascites is typically transudative with SAAG \u003e1.1 g/dL."
                          }
                      ],
