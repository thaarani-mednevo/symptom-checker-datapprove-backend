    "differentials":  [
                          {
                              "disease_code":  "ALCOHOLIC_CIRRHOSIS_OF_LIVER_WITHOUT_ASCITES",
                              "distinguishing_feature":  "Cirrhosis reflects end-stage chronic liver damage with fibrosis and portal hypertension; alcoholic hepatitis is an acute inflammatory episode that may be superimposed on underlying cirrhosis."
                          },
                          {
                              "disease_code":  "VIRAL_HEPATITIS_B",
                              "distinguishing_feature":  "Viral hepatitis B presents with similar jaundice and elevated LFTs but is confirmed by HBsAg serology; alcoholic hepatitis has AST:ALT \u003e2:1 and clear alcohol history."
                          },
