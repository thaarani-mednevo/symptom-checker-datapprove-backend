    "differentials":  [
                          {
                              "disease_code":  "COPD",
                              "distinguishing_feature":  "COPD causes daytime breathlessness and obstructive spirometry; OSA causes nocturnal symptoms with normal spirometry. Overlap syndrome (OSA + COPD) can coexist."
                          },
                          {
                              "disease_code":  "HEART_FAILURE",
                              "distinguishing_feature":  "Heart failure causes central sleep apnoea (Cheyne-Stokes respiration) and orthopnoea; OSA causes obstructive events due to pharyngeal collapse and is worsened by supine position and obesity."
                          },
                          {
                              "disease_code":  "HYPOTHYROIDISM",
                              "distinguishing_feature":  "Hypothyroidism can cause or worsen OSA through macroglossia and pharyngeal oedema; thyroid function should be checked in all new OSA patients."
                          }
