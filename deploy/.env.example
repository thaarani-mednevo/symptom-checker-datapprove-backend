# Copy to /home/ubuntu/apps/mednevo/symptom_checker/backend/shared/.env  (chmod 600)
# systemd reads this file directly: plain KEY=value lines, no quotes, no `export`.

DEBUG=False
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

ALLOWED_HOSTS=data.api.mednevo.com,data.mednevo.com,15.204.255.36,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://data.api.mednevo.com,https://data.mednevo.com
# Only needed if a frontend on ANOTHER domain calls the API directly.
# data.mednevo.com proxies /api/ through Nginx (same origin), so it needs no CORS entry.
CORS_ALLOWED_ORIGINS=

# Database: separate vars (used if DB_NAME is set and DATABASE_URL is not)...
DB_NAME=datapprove
DB_USER=datapprove
DB_PASS=CHANGE_ME
POSTGRES_HOST=127.0.0.1
DB_PORT=5434
# ...or one URL instead (takes priority if set):
# DATABASE_URL=postgres://datapprove:CHANGE_ME@127.0.0.1:5434/datapprove

# Persistent data dir (outside git-tracked files) - doctor edits live here
KNOWLEDGE_DB_DIR=/home/ubuntu/apps/mednevo/symptom_checker/backend/shared/database

GROQ_API_KEY=
GROQ_MODEL=

LOG_LEVEL=INFO
